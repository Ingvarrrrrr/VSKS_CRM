# Контекст сборки образа. Без этого файла `COPY . .` тащил в образ хостовые
# node_modules (~324 МБ с ВИНДОВЫМИ бинарями @esbuild/win32-x64,
# @rollup/rollup-win32-*) поверх поставленных внутри контейнера линуксовых, плюс
# локальный dist. Сборка от этого не падала, но контекст и слой раздувались, а
# смешение платформенных пакетов — источник трудноуловимых поломок.
node_modules
dist
.ssr-dist

# Локальные артефакты и мусор, которым нечего делать в образе
.tmp_test
*.local
*.log
.vscode
.idea
coverage
